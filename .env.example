# ---------------------------------------------------------------------------
# Waste Opportunities configuration
# ---------------------------------------------------------------------------
# NOTE ON THE RENAME: settings used to be prefixed LOOPNZ_. The new prefix is
# WASTEOPS_, but the old names are still read as a fallback, so an existing
# .env written before the rename keeps working untouched.
# ---------------------------------------------------------------------------
# 1. Copy this file and rename the copy to  .env  (no ".example" on the end)
#    Windows:  copy .env.example .env
#    Mac/Linux: cp .env.example .env
# 2. Paste your API key below
# 3. Restart the server, then run  npm run check-ai  to confirm it works
#
# WITHOUT a key the app still runs — the chatbot falls back to a built-in
# offline assistant that can still search, filter and drive the website.
# ---------------------------------------------------------------------------


# ===========================================================================
#  GOOGLE GEMINI  —  the default provider
# ===========================================================================
# Free key, no credit card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Which Gemini model to use.
#   gemini-flash-latest             best quality of the free models (default)
#   gemini-flash-lite-latest        ~3x faster, good for a live demo
#   gemini-3-flash-preview          alternative if the above are out of quota
# You normally do NOT need to set this: if a model runs out of daily quota,
# Waste Opportunities automatically rotates to the next one on the list.
# LOOPNZ_GEMINI_MODEL=gemini-flash-latest

# ---------------------------------------------------------------------------
# IMPORTANT — free tier daily limits
# ---------------------------------------------------------------------------
# Google's free tier allows roughly 20 requests PER DAY, PER MODEL. One chat
# message costs 2-3 requests (the AI calls tools, then answers), so a single
# model gives you about 7 messages a day.
#
# Waste Opportunities rotates across 4 models automatically, so you get roughly 28 messages
# a day in total. Quotas reset daily.
#
# Run "npm run check-ai" to see how much you have left before a demo.
# Don't burn the allowance testing on the morning of your pitch.
# ---------------------------------------------------------------------------


# ===========================================================================
#  ANTHROPIC CLAUDE  —  optional alternative
# ===========================================================================
# Requires paid API credits (a Claude.ai subscription does NOT include these).
# Key from https://console.anthropic.com/settings/keys
# Needs "npm install" to have been run, for the Anthropic SDK.
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Which Claude model to use.
#   claude-sonnet-5   cost-effective (default)
#   claude-opus-5     most capable, roughly 2.5x the cost
LOOPNZ_CLAUDE_MODEL=claude-sonnet-5

# How hard Claude thinks before answering (Claude only — Gemini ignores this).
#   low    = fastest replies, good for a live demo
#   medium = balanced (default)
#   high   = most thorough, noticeably slower
LOOPNZ_EFFORT=medium


# ===========================================================================
#  PROVIDER SELECTION
# ===========================================================================
# Leave this commented out and Waste Opportunities picks automatically: Gemini if
# GEMINI_API_KEY is set, otherwise Claude if ANTHROPIC_API_KEY is set,
# otherwise the offline assistant.
#
# Set it to force one:
#   gemini   use Google Gemini
#   claude   use Anthropic Claude even if a Gemini key is also present
#   offline  use the built-in assistant only (no API calls, no cost)
# LOOPNZ_PROVIDER=gemini


# ===========================================================================
#  SERVER
# ===========================================================================
# Port for the local web server.
PORT=3000
